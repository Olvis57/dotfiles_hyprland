
;; ── welcome text ────────────────────────────────────────────────────
;; Text displaying date and weather
;; Anchored right screen

(defwindow welcome_text
  :visible show_eww
  :anchor "top left"
  :monitor 0
  :geometry (geometry :x "20px" :y "15px" :width "400px" :height "120px")
  :stacking "bg"
  :exclusive false
  :focusable false

  (box :orientation "vertical" :halign "end" :class "stats-box"

  ;; Welcome Line
(label :text "> Dobro pozhalovat, ${USER}" :class "label-primary aurebesh" :halign "end" :style "margin-top: -10px;")

;; Date Line
(label :text "Segodnya: ${welcome_date}" :class "label-primary aurebesh" :halign "end" :style "margin-top: -40px;")

;; Weather Line
(label :text "Pogoda: ${weather_forecast}" :class "label-primary aurebesh" :halign "end" :style "margin-top: -70px;")




  )
)
