;; ── welcome text───────────────────────────────────────────────────
;; Text displaying date and weather in cyrilic
;; Anchored right screen

(defwindow welcome_text
  :visible show_eww
  :anchor "top left"
  :monitor 0
  :geometry (geometry :x "20px" :y "15px" :width "400px" :height "120px")
  :stacking "bg"
  :exclusive false
  :focusable false

  (box :orientation "vertical" :halign "end" :class "stats-box"

    ;; Welcome Line
    (label :text "> Добро пожаловать, ${USER}" :class "label-primary" :halign "end" :style "margin-top: -10px;")

    ;; Date Line
    (label :text "Сегодня: ${welcome_date}" :class "label-primary" :halign "end" :style "margin-top: -40px;")

    ;; Weather Line
    (label :text "Погода: ${weather_forecast}" :class "label-primary" :halign "end" :style "margin-top: -70px;")
  )
)

