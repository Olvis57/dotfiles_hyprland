;; ── right fan data───────────────────────────────────────────────────
;; Text displaying cooling and fan RPM
;; Anchored bottom right


(defwindow right_fan_data
  :visible show_eww
  :anchor "top left"
  :monitor 0
  :geometry (geometry :x "171px" :y "460px" :width "200px" :height "64px")
  :stacking "bg"
  :exclusive false
  :focusable false

  (box :orientation "vertical" :halign "start" :space "4px"

        ;; FAN
        (box :orientation "horizontal" :halign "start" :space "4px" :style "margin-top:-8px;"
          (label :text "> " :class "power-label2"   :halign "end"   )
          (label :text "cpu vent:  " :class "power-label3")
      (label :text cpu_fan_rpm :class "power-value" :halign "start"  )
        )

        ;; FAN
        (box :orientation "horizontal" :halign "start" :space "4px" :style "margin-top: -10px; margin-left:-14px"
          (label :text "> " :class "power-label2"   :halign "end"   )
          (label :text "zhivopotok: " :class "power-label3")
         (label :text gpu_fan_ascii :class "power-value"  :halign "start"  )
        )
        ;; fan
        (box :orientation "horizontal" :halign "start" :space "4px" :style "margin-top:-10px;margin-left:-2px"
          (label :text "> " :class "power-label2"   :halign "end"   )
          (label :text "gpu vent:  " :class "power-label3")
      (label :text gpu_fan_rpm :class "power-value" :halign "start"  )
        )

        ;;fan
        (box :orientation "horizontal" :halign "start" :space "4px" :style "margin-top: -10px;margin-left:-14px"
          (label :text "> " :class "power-label2"   :halign "end"   )
          (label :text "zhivopotok: " :class "power-label3")
         (label :text gpu_fan_ascii :class "power-value"  :halign "start"  )
        )

 
)
 
)
