;; ── orange workspace ───────────────────────────────────────────────────
;; Vectors displaying reactor number in cyrilic text
;; Anchored middle right

(defwindow orange_workspace
  :visible show_eww
  :anchor "top left"
  :geometry (geometry :x "371px" :y "249px" :width "60px" :height "100px")
  :stacking "bg"
  :exclusive false
  :focusable false
  :monitor 0
 
  (box :orientation "vertical" :space "10px" 
    (box :class "info-right-box" :valign "end" :halign "start" (label :text "A1" :class "info-right-text aurebesh"     ))
    (box :class "info-right-box" :valign "end" :halign "start" (label :text "B2" :class "info-right-text aurebesh"    ))
    (box :class "info-right-box" :valign "end" :halign "start" (label :text "C3" :class "info-right-text aurebesh"    ))
    (box :class "info-right-box" :valign "end" :halign "start" (label :text "D4" :class "info-right-text aurebesh"    ))))

